NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bingo:bingo@localhost:5432/bingo?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
BOT_TOKEN=
BOT_USERNAME=
WEBAPP_URL=http://localhost:5173
ADMIN_TELEGRAM_IDS=
DEV_AUTH=true
DEV_AUTH_KEY=replace-with-a-long-local-only-key
BOT_MODE=off
TELEGRAM_WEBHOOK_SECRET=replace-with-an-independent-random-secret
BOARD_SIZE=5
NUMBER_MIN=1
NUMBER_MAX=40
WIN_LINES=5
RECONNECT_GRACE_SECONDS=60
ABANDON_SECONDS=600
LOBBY_TTL_SECONDS=1800
QUEUE_TTL_SECONDS=120
TURN_TIMER_SECONDS=0
TRUST_PROXY=0

# Optional cloud development fallback; never used for production migrations
PRISMA_JS_SCHEMA_ENGINE=false
